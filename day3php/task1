<?php


class Circle{

    // variables
    private $radius;
    private $color;

    //constructor 
    function __construct($radius , $color){
        $this->radius = $radius;
        $this->color = $color;
    }

    // getter & setter for redius 
    function getRadius(){
        return $this->radius;
    }
    function setRadius($r):void{
         $this->radius = $r ;
    }

    // getter & setter for color
    function getcolor(){
        return $this->color;
    }
    function setcolor($c):void{
         $this->color = $c ;
    }

    // to string fun
    function toString():String{  return "Circle[radius={$this->radius}, color={$this->color}]"; }

    // calc Area 
    function getArea(){
       return pi() * $this->radius * $this->radius;
    }
}
$c = new Circle(1.0 , "red");
echo $c->toString() . "<br>";
echo "Area = " . $c->getArea();


